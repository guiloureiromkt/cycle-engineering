#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.cycle/work/<plan-basename>/.run/task-<N>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  # Invoke via bash rather than direct exec: some extractors (Python zipfile)
  # strip Unix exec bits when unpacking marketplace packages (#2040).
  dir=$("${BASH:-bash}" "$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
fi

# cycle divergence (2026-09-23): a task heading is `Task N` or `Tarefa N` (plans are written in
# Portuguese too), and N ends at the first non-alphanumeric so Task 7 never swallows Task 7b.
awk -v n="$n" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+(Task|Tarefa)[ \t]+[0-9]+/ {
    intask = ($0 ~ ("^#+[ \t]+(Task|Tarefa)[ \t]+" n "([^0-9A-Za-z]|$)"))
  }
  intask { print }
' "$plan" > "$out"

# A plan with no task heading at all (a third of real plans) gets the whole plan as its brief.
if [ ! -s "$out" ] && ! awk '/^```/{f=!f} !f && /^#+[ \t]+(Task|Tarefa)[ \t]+[0-9]+/{found=1} END{exit !found}' "$plan"; then
  cp "$plan" "$out"
  echo "task-brief: no task heading in ${plan}; the brief for task ${n} is the whole plan" >&2
fi

if [ ! -s "$out" ]; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
